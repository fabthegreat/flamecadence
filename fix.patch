+                        bestDate = d
+                        nextName = o.optString("name", "Workout")
+                    }
+                }
+                bestDate?.let { d ->
+                    nextWhen = if (d == tomorrow) "tomorrow"
+                    else fmt.parse(d)?.let { SimpleDateFormat("EEEE", Locale.getDefault()).format(it) } ?: d
+                }
+            } catch (e: Exception) { }
+
+            WeekSummary(ctlDelta, load, nextName, nextWhen)
