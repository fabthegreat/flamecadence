+            cal.add(Calendar.DAY_OF_YEAR, -7); val weekAgo = fmt.format(cal.time)
+            cal.add(Calendar.DAY_OF_YEAR, 8); val tomorrow = fmt.format(cal.time)
+            cal.add(Calendar.DAY_OF_YEAR, 13); val horizon = fmt.format(cal.time)
